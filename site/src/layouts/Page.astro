---
import { ClientRouter } from 'astro:transitions';
import { LANGS, LANG_META, langOf, useText, type Lang } from '../i18n';
import { loadLaws } from '../data/laws';
import { collectSources } from '../data/sources';
import { AUTHOR, CHECKED, REPO } from '../data/site';
import Header from '../components/Header.astro';
import TabBar from '../components/TabBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import { fontsFor } from '../assets/fonts';

const lang = langOf(Astro.url);
const { get, dict } = useText(lang);
// the first screen's fonts, in the alphabet this language uses, start loading with the HTML
const preloadFonts = fontsFor(lang).now;
const sources = collectSources(dict, loadLaws(lang));
const absolute = (l: Lang) => new URL(LANG_META[l].path, Astro.site).href;
// social previews come from og/render.py; the alt text is the title drawn on the image
const ogImage = new URL(`og/${lang}.png`, Astro.site).href;
const ogImageAlt = get<string>('header.title').replace(/<[^>]+>/g, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: get<string>('meta.title'),
  inLanguage: lang,
  dateModified: CHECKED,
  author: { '@type': 'Person', ...AUTHOR },
  citation: sources,
  about: get<string[]>('meta.about'),
  description: get<string>('meta.ldDescription'),
  hasPart: [
    { '@type': 'Dataset', name: get('meta.datasetName'), description: get('meta.datasetDescription'), encodingFormat: 'application/json', contentUrl: LANG_META[lang].laws, dateModified: CHECKED },
    { '@type': 'SoftwareSourceCode', name: 'privacy-for-builders', codeRepository: REPO, description: get('meta.codeDescription') },
  ],
};
---
<!doctype html>
<html lang={lang} transition:animate="none">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{get('meta.title')}</title>
  <meta name="description" content={get('meta.description')}>
  <meta property="og:title" content={get('meta.title')}>
  <meta property="og:description" content={get('meta.ogDescription')}>
  <meta property="og:type" content="article">
  <meta property="og:url" content={absolute(lang)}>
  <meta property="og:site_name" content={new URL(Astro.site!).host}>
  <meta property="og:locale" content={LANG_META[lang].locale}>
  {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].locale}>)}
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#EEF1F5" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0C1119" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  {preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin>)}
  <link rel="author" href={AUTHOR.url}>
  <link rel="alternate" type="application/json" href={LANG_META[lang].laws} title={get('meta.lawsDataTitle')}>
  <link rel="alternate" type="text/markdown" href="llms.txt" title={get('meta.summaryTitle')}>
  <link rel="canonical" href={absolute(lang)}>
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={absolute(l)}>)}
  <link rel="alternate" hreflang="x-default" href={absolute('en')}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- before first paint: a saved theme never flashes the other one, and only the first tab shows until the router picks one -->
  <script is:inline>
    document.documentElement.classList.add('js');
    try { const s = localStorage.getItem('gdpr-theme'); if (s === 'light' || s === 'dark') document.documentElement.style.colorScheme = s; } catch {}
  </script>
  <ClientRouter fallback="swap" />
</head>
<body>
  <div class="wrap">
    <Header />
    <TabBar />
    <main><slot /></main>
    <Footer sources={sources} />
  </div>
  <script>
    import '../scripts/app';
  </script>
</body>
</html>
