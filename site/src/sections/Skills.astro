---
import { langOf, useText } from '../i18n';
import Tile from '../components/Tile.astro';
import Button from '../components/Button.astro';
import CopyCommand from '../components/CopyCommand.astro';
import { REPO } from '../data/site';

const { t, get, html } = useText(langOf(Astro.url));
const INSTALL = `git clone ${REPO}
mkdir -p ~/.agents/skills ~/.claude/skills
cp -r privacy-for-builders/skills/* ~/.agents/skills/
cp -r privacy-for-builders/skills/* ~/.claude/skills/`;
const answer = get<string[]>('skills.chat.answer');
const findingsAt = answer.length - 1; // the findings list sits before the closing question
---
<Tile span={12} id="skills" class="skills night">
  <div class="sk-grid">
    <div>
      <h3 id="skills-h" set:html={t('skills.title')} />
      <p class="sk-lead" set:html={t('skills.lead')} />
      <div class="sk-cta">
        <Button href={REPO} variant="mark">{get('skills.github')}</Button>
        <Button href="#sk-install" variant="line">{get('skills.install')}</Button>
      </div>
      <CopyCommand id="sk-install" title={get('skills.install')} command={INSTALL} />
      <p class="sk-note" set:html={t('skills.note')} />
    </div>
    <figure class="chat" aria-label={get('skills.chat.label')}>
      <p class="u">{get('skills.chat.question')}</p>
      {/* the agent's own tags, like [inference], stay as typed: they are not this page's source badges */}
      <div class="a">
        {answer.slice(0, findingsAt).map((p) => <p set:html={p} />)}
        <ol>{get<string[]>('skills.chat.findings').map((f) => <li set:html={f} />)}</ol>
        <p set:html={answer[findingsAt]} />
      </div>
      <figcaption set:html={t('skills.chat.caption')} />
    </figure>
  </div>
  <ol class="pipe" aria-label={get('skills.pipeline.label')}>
    <li><b>{get('skills.pipeline.you.title')}</b><span>{get('skills.pipeline.you.text')}</span></li>
    <li><b translate="no">privacy-director</b><span>{get('skills.pipeline.director')}</span></li>
    <li class="pair">
      <div><b translate="no">privacy-code-audit</b><span>{get('skills.pipeline.audit')}</span></div>
      <div><b translate="no">privacy-jurisdictions</b><span>{get('skills.pipeline.jurisdictions')}</span></div>
    </li>
    <li><b>{get('skills.pipeline.report.title')}</b><span>{get('skills.pipeline.report.text')}</span></li>
  </ol>
  <ul class="proof">
    {get<{ value: string; text: string }[]>('skills.proof').map((p) => <li><b>{p.value}</b><Fragment set:html={html(p.text)} /></li>)}
  </ul>
  <p class="sk-fine" set:html={t('skills.fine')} />
</Tile>

<style is:global>
  .skills{padding:28px 28px 22px}
  .skills a:not(.btn){color:inherit}
  .sk-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:32px;align-items:center}
  .skills h3{font-size:clamp(1.35rem,2.8vw,1.9rem);font-weight:600;line-height:1.18;margin:0 0 12px;letter-spacing:-.01em}
  .sk-lead{color:#C3CADA;font-size:.95rem;margin:0 0 18px;max-width:52ch}
  .sk-cta{display:flex;flex-wrap:wrap;gap:10px}
  .sk-note{font-size:.78rem;color:#9AA3B5;margin:8px 0 0}
  .chat{margin:0;background:var(--sheet);color:var(--ink);border-radius:16px;padding:18px 20px;font-size:.88rem;display:flex;flex-direction:column;gap:10px}
  .chat .u{align-self:flex-end;max-width:85%;margin:0;background:var(--paper);border-radius:14px;padding:9px 13px}
  .chat .a p{margin:.35rem 0}
  .chat .a ol{margin:.2rem 0 .4rem;padding-left:1.2rem}
  .chat .a li{margin:.25rem 0}
  .chat i{font-style:normal;font-size:.74rem;color:var(--ink-3);white-space:nowrap}
  .chat code{font-size:.8rem;background:var(--paper);border-radius:4px;padding:0 4px}
  .chat figcaption{font-size:.74rem;color:var(--ink-3);border-top:1px solid var(--rule);padding-top:10px}
  .pipe{list-style:none;padding:0;margin:26px 0 0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;position:relative}
  .pipe::before{content:"";position:absolute;left:8px;right:calc((100% - 60px) / 4 + 6px);top:9px;height:1px;background:rgba(238,241,245,.22)}
  .pipe li{position:relative;margin:0;padding-top:26px;font-size:.84rem;color:#B6BECF}
  .pipe li::before{content:"";position:absolute;left:0;top:4px;width:11px;height:11px;border-radius:50%;background:var(--night);border:2px solid #93A6FF}
  .pipe b{display:block;color:#EEF1F5;font-weight:600;font-size:.84rem;line-height:1.4;margin-bottom:2px}
  .pipe b[translate]{font:600 .8rem/1.5 var(--mono);color:#B9C6FF}
  .pipe span{display:block;line-height:1.45}
  .pipe .pair{display:grid;gap:8px}
  .proof{list-style:none;padding:18px 0 0;margin:22px 0 0;border-top:1px solid rgba(238,241,245,.14);display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .proof li{margin:0;font-size:.82rem;color:#B6BECF}
  .proof b{display:block;font:600 1.5rem/1.15 var(--display);color:#FFE15C;margin-bottom:2px}
  .sk-fine{font-size:.76rem;color:#8F98AB;margin:14px 0 0}
  @media (max-width:900px){
    .sk-grid{grid-template-columns:minmax(0,1fr)}
    .pipe{grid-template-columns:minmax(0,1fr);gap:14px}
    .pipe::before{left:5px;right:auto;top:8px;bottom:8px;width:1px;height:auto}
    .pipe li{padding:0 0 0 26px}
    .pipe li::before{top:3px}
    .proof{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  @media (max-width:520px){.skills{padding:20px 18px}.proof{grid-template-columns:minmax(0,1fr)}.chat i{white-space:normal}}
</style>
