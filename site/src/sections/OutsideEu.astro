---
import { langOf, useText } from '../i18n';
import Tile from '../components/Tile.astro';

const { t, get, html } = useText(langOf(Astro.url));
const ADEQUACY = 'https://commission.europa.eu/law/law-topic/data-protection/international-dimension-data-protection/adequacy-decisions_en';
---
<Tile span={12} id="outside" title={t('outside.title')}>
  <div class="quad">{get<string[]>('outside.items').map((item) => <p set:html={html(item)} />)}</div>
  <p set:html={t('outside.countries')} />
  <p class="src"><a href={ADEQUACY}>{get('outside.adequacyList')}</a></p>
</Tile>
