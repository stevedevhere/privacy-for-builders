---
import { langOf, useText } from '../i18n';
import Tile from '../components/Tile.astro';

/** How a regulator gets involved: three ways in, then four numbered steps. */
const { t, get, html } = useText(langOf(Astro.url));
---
<Tile span={7} id="checks" title={t('checks.title')} class="wide-on-tablet">
  <p class="lead" set:html={t('checks.lead')} />
  <div class="inputs">{get<string[]>('checks.inputs').map((x) => <div set:html={html(x)} />)}</div>
  <div class="arrow" aria-hidden="true">↓</div>
  <ol class="flow">{get<string[]>('checks.flow').map((x) => <li set:html={html(x)} />)}</ol>
  <div class="parallel" set:html={t('checks.parallel')} />
  <p class="muted" set:html={t('checks.note')} />
  <p class="src" set:html={t('checks.sources')} />
</Tile>

<style is:global>
  .inputs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
  .inputs div{border:1px dashed var(--ink-3);border-radius:8px;padding:8px 12px;font-size:.84rem}
  .inputs b{display:block}
  .arrow{text-align:center;color:var(--ink-3);font-size:.85rem;margin:4px 0}
  .flow{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:0 0 8px;counter-reset:step}
  .flow li{margin:0;background:var(--paper);border-radius:8px;padding:12px;font-size:.84rem}
  .flow li b{display:block;font-weight:600}
  .flow li::before{counter-increment:step;content:counter(step);font:500 .74rem var(--display);color:var(--accent)}
  .parallel{border:1px solid var(--rule);border-radius:8px;padding:8px 12px;font-size:.84rem}
  @media (max-width:820px){.inputs{grid-template-columns:1fr}.flow{grid-template-columns:1fr 1fr}}
</style>
