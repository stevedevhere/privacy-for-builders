---
import { langOf, useText } from '../i18n';
import Tile from '../components/Tile.astro';

/** A worked example: each kind of data the couples test app holds, its category, what it needs and the cost of a mistake. */
const { t, get, html } = useText(langOf(Astro.url));
type Row = { data: string; category: string[]; need: string; wrong: string };
const rows = get<Record<string, Row>>('example.rows');
const columns = get<Record<'data' | 'category' | 'need' | 'wrong', string>>('example.columns');
/** Row order and the risk level of each category label in it (the labels are translated). */
const ROWS = [
  { id: 'anxiety', risks: ['hi'] },
  { id: 'intimacy', risks: ['hi'] },
  { id: 'profile', risks: ['mid', 'hi'] },
  { id: 'joint', risks: ['hi'] },
  { id: 'nonUser', risks: ['lo'] },
  { id: 'technical', risks: ['lo'] },
  { id: 'age', risks: ['mid'] },
];
---
<Tile span={12} id="example" title={t('example.title')}>
  <p class="muted lead" set:html={t('example.lead')} />
  <div class="map">
    <div class="row head" aria-hidden="true">
      <span>{columns.data}</span><span>{columns.category}</span><span>{columns.need}</span><span>{columns.wrong}</span>
    </div>
    {ROWS.map(({ id, risks }) => (
      <div class="row">
        <div><span class="k">{columns.data}</span><Fragment set:html={html(rows[id].data)} /></div>
        <div>
          <span class="k">{columns.category}</span>
          {rows[id].category.map((label, j) => <span class:list={['risk', risks[j]]}>{label}</span>)}
        </div>
        <div><span class="k">{columns.need}</span><Fragment set:html={html(rows[id].need)} /></div>
        <div><span class="k">{columns.wrong}</span><Fragment set:html={html(rows[id].wrong)} /></div>
      </div>
    ))}
  </div>
  <div class="callout">{get<string[]>('example.callouts').map((c) => <div set:html={html(c)} />)}</div>
</Tile>

<style is:global>
  .map{display:grid;gap:8px;margin-top:10px}
  .row{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.8fr) minmax(0,1.5fr) minmax(0,1.2fr);gap:16px;padding:12px 16px;border:1px solid var(--rule);border-radius:10px;font-size:.87rem;align-items:start}
  .row.head{border:none;padding:0 16px;font-size:.76rem;color:var(--ink-3);font-weight:600}
  .row b{display:block}
  .row .risk{white-space:normal;display:flex;margin-bottom:2px}
  .row .k{font-size:.74rem;color:var(--ink-3);display:none}
  .callout{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}
  .callout div{background:var(--paper);border-radius:8px;padding:12px;font-size:.86rem}
  @media (max-width:900px){.row{grid-template-columns:repeat(2,minmax(0,1fr))}.row.head{display:none}.row .k{display:block}}
  @media (max-width:820px){.callout{grid-template-columns:1fr}}
  @media (max-width:520px){.row{grid-template-columns:1fr}}
</style>
