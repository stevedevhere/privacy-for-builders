---
import { langOf, useText } from '../i18n';
import Tile from '../components/Tile.astro';

const { t, get } = useText(langOf(Astro.url));
const CATEGORIES = [
  { id: 'ordinary', risk: 'mid' },
  { id: 'special', risk: 'hi' },
  { id: 'inferred', risk: 'hi' },
  { id: 'children', risk: 'mid' },
  { id: 'profiling', risk: 'mid' },
  { id: 'pseudonymous', risk: 'lo' },
] as const;
---
<Tile span={12} id="cats" title={t('categories.title')}>
  <p class="muted lead" set:html={t('categories.lead')} />
  <div class="cats">
    {CATEGORIES.map(({ id, risk }) => (
      <article class="cat">
        <h4 set:html={t(`categories.items.${id}.title`)} />
        <span class:list={['risk', risk]} set:html={t(`categories.items.${id}.level`)} />
        <p class="ex" set:html={t(`categories.items.${id}.example`)} />
        <dl>
          <dt>{get('categories.need')}</dt><dd set:html={t(`categories.items.${id}.need`)} />
          <dt>{get('categories.cost')}</dt><dd set:html={t(`categories.items.${id}.cost`)} />
        </dl>
      </article>
    ))}
  </div>
  <p class="muted" set:html={t('categories.note')} />
  <p class="src" set:html={t('categories.sources')} />
</Tile>

<style is:global>
  .cats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:10px}
  .cat{min-width:0;border:1px solid var(--rule);border-radius:10px;padding:12px 16px;display:flex;flex-direction:column;gap:6px;font-size:.88rem}
  .cat>.risk{font-weight:400;font-size:.78rem;color:var(--ink-2)}
  .cat h4{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 8px;align-items:baseline}
  .cat h4 small{font:500 .74rem var(--body);color:var(--accent);border:1px solid var(--rule);border-radius:4px;padding:2px 6px;white-space:nowrap}
  .cat .ex{color:var(--ink-2)}
  .cat dl{margin:0;display:grid;gap:6px}
  .cat dt{font-weight:600;font-size:.8rem;color:var(--ink-3)}
  .cat dd{margin:0}
  @media (max-width:1000px){.cats{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:620px){.cats{grid-template-columns:1fr}}
</style>
