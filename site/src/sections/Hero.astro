---
import { langOf, useText } from '../i18n';
import Tile from '../components/Tile.astro';

const { t, get, html } = useText(langOf(Astro.url));
---
<Tile span={8} class="hero" title={t('hero.title')}>
  <p set:html={t('hero.lead')} />
  <div class="four">
    {get<string[]>('hero.pillars').map((p) => <div set:html={html(p)} />)}
  </div>
  <div class="when">
    <div>
      <h4 set:html={t('hero.applies.title')} />
      <p set:html={t('hero.applies.text')} />
    </div>
    <div>
      <h4 set:html={t('hero.urgent.title')} />
      <ul>{get<string[]>('hero.urgent.items').map((item) => <li set:html={html(item)} />)}</ul>
      <p><a href="#when">{get('hero.stagesLink')}</a></p>
    </div>
  </div>
</Tile>

<style is:global>
  .hero{background:var(--hero);color:var(--hero-ink);border-color:var(--hero);display:flex;flex-direction:column}
  .hero h3{font-size:clamp(1.15rem,2.4vw,1.5rem);line-height:1.25;margin-bottom:.8rem}
  .hero a{color:inherit}
  .hero .tag{background:var(--hero-wash);color:inherit;opacity:.85}
  .four{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:16px 0 24px}
  .four div{background:var(--hero-wash);border-radius:8px;padding:12px;font-size:.88rem}
  .four b{display:block;font-weight:600;font-size:.9rem;color:var(--hero-key);margin-bottom:2px}
  .when{display:grid;grid-template-columns:1fr 1fr;gap:24px;padding-top:16px;margin-top:auto;border-top:1px solid var(--hero-rule)}
  .when h4{font-size:1rem}
  @media (max-width:700px){.four{grid-template-columns:1fr 1fr}.when{grid-template-columns:1fr}}
</style>
